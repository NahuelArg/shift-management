generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CLIENT
  ADMIN
  EMPLOYEE
}

enum AuthProvider {
  LOCAL
  GOOGLE
  APPLE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

model User {
  id                  String         @id @default(uuid())
  name                String
  password            String?
  email               String         @unique
  phone               String?
  role                Role           @default(CLIENT)
  authProvider        AuthProvider   @default(LOCAL)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  businesses          Business[]     @relation("BusinessOwner")
  bookings            Booking[]
  employeeBookings    Booking[]      @relation("EmployeeBookings")
  business            Business?      @relation("BusinessEmployees", fields: [businessId], references: [id], onDelete: Cascade)
  businessId          String?
  CashRegistersOpened CashRegister[] @relation("CashRegisterOpenedBy")
  CashRegistersClosed CashRegister[] @relation("CashRegisterClosedBy")
  CashMovements       CashMovement[] @relation("CashMovementCreatedBy")
  CashClosings        CashClosing[]  @relation("CashClosingClosedBy")

  @@index([businessId])
}

model Business {
  id            String         @id @default(uuid())
  name          String
  // Zona horaria IANA del negocio: se usa para validar el horario de atención
  // (antes se usaba la que mandaba el cliente, que podía falsearla)
  timezone      String         @default("Europe/Madrid")
  owner         User           @relation("BusinessOwner", fields: [ownerId], references: [id])
  ownerId       String
  services      Service[]
  schedules     Schedule[]
  bookings      Booking[]
  employees     User[]         @relation("BusinessEmployees")
  cashRegisters CashRegister[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([ownerId])
}

model Service {
  id          String    @id @default(uuid())
  name        String
  description String?
  durationMin Int       @default(30)
  price       Decimal   @db.Decimal(12, 2)
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId  String
  bookings    Booking[]
  // Soft delete: un servicio "borrado" se desactiva para conservar el historial
  // de reservas y cobros (antes el borrado en cascada eliminaba esas reservas)
  active      Boolean   @default(true)

  @@index([businessId])
}

model Schedule {
  id         String   @id @default(uuid())
  dayOfWeek  Int // 0 = domingo, 6 = sábado
  from       String // "09:00"
  to         String // "17:00"
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String

  @@index([businessId, dayOfWeek])
}

model Booking {
  id            String         @id @default(uuid())
  // Borrar un cliente ya no borra su historial de reservas: quedan sin cliente (como un walk-in)
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId        String?
  timezone      String         @default("UTC")
  // NoAction (no Restrict): impide borrar un servicio con reservas, pero deja que el
  // borrado en cascada de un Business elimine reservas y servicios en la misma sentencia
  service       Service        @relation(fields: [serviceId], references: [id], onDelete: NoAction)
  serviceId     String
  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId    String
  employee      User?          @relation("EmployeeBookings", fields: [employeeId], references: [id], onDelete: SetNull)
  employeeId    String?
  date          DateTime
  endTime       DateTime
  finalPrice    Decimal        @db.Decimal(12, 2)
  status        BookingStatus  @default(PENDING)
  paymentStatus PaymentStatus  @default(PENDING)
  paymentMethod PaymentMethod?
  cashMovement  CashMovement[]
  createdAt     DateTime       @default(now())

  @@index([userId])
  @@index([employeeId])
  @@index([serviceId])
  @@index([businessId, date])
  @@index([paymentStatus])
}

//Cash Register enums

enum CashRegisterStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  OPENING
  SALE
  EXPENSE
  WITHDRAWAL
  DEPOSIT
  CLOSING
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  MIXED
}

model CashRegister {
  id             String             @id @default(uuid())
  name           String
  business       Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId     String
  currentBalance Decimal            @default(0) @db.Decimal(12, 2)
  status         CashRegisterStatus @default(CLOSED)
  openedAt       DateTime?
  OpenedBy       User?              @relation("CashRegisterOpenedBy", fields: [openedById], references: [id], onDelete: SetNull)
  openedById     String?
  closedAt       DateTime?
  ClosedBy       User?              @relation("CashRegisterClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  closedById     String?
  movements      CashMovement[]
  closings       CashClosing[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([businessId, status])
  @@index([openedById])
  @@index([closedById])
}

model CashMovement {
  id             String           @id @default(uuid())
  cashRegister   CashRegister     @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)
  cashRegisterId String
  type           CashMovementType
  amount         Decimal          @db.Decimal(12, 2)
  paymentMethod  PaymentMethod    @default(CASH)
  booking        Booking?         @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  bookingId      String?
  description    String?
  metadata       Json?
  CreatedBy      User             @relation("CashMovementCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdById    String
  createdAt      DateTime         @default(now())

  @@index([cashRegisterId, createdAt])
  @@index([type])
  @@index([bookingId])
  @@index([createdById])
}

model CashClosing {
  id              String       @id @default(uuid())
  cashRegister    CashRegister @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)
  cashRegisterId  String
  openingBalance  Decimal      @db.Decimal(12, 2)
  expectedBalance Decimal      @db.Decimal(12, 2)
  actualBalance   Decimal      @db.Decimal(12, 2)
  difference      Decimal      @db.Decimal(12, 2)
  totalSales      Decimal      @db.Decimal(12, 2)
  totalExpenses   Decimal      @db.Decimal(12, 2)
  totalCash       Decimal      @db.Decimal(12, 2)
  totalCard       Decimal      @db.Decimal(12, 2)
  totalTransfer   Decimal      @db.Decimal(12, 2)
  notes           String?
  ClosedBy        User         @relation("CashClosingClosedBy", fields: [closedById], references: [id], onDelete: Cascade)
  closedById      String
  closedAt        DateTime     @default(now())

  @@index([cashRegisterId, closedAt])
  @@index([closedById])
}
